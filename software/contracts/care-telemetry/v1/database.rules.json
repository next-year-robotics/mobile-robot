{
  "rules": {
    "robots": {
      "$robot_id": {
        ".read": "auth != null && root.child('access').child($robot_id).child(auth.uid).exists()",
        ".write": false,
        "events": { ".indexOn": ["ts_ms", "kind"] }
      }
    },
    "access": {
      "$robot_id": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": false
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['email'])"
      }
    }
  }
}
