{
  "rules": {
    "robots": {
      "$robot_id": {
        ".write": false,
        "meta": {
          ".read": "auth != null && root.child('access').child($robot_id).child(auth.uid).exists()"
        },
        "status": {
          ".read": "auth != null && root.child('access').child($robot_id).child(auth.uid).exists()"
        },
        "events": {
          ".read": "auth != null && root.child('access').child($robot_id).child(auth.uid).exists()",
          ".indexOn": ["ts_ms", "kind"]
        },
        "sos": {
          ".read": "auth != null && root.child('access').child($robot_id).child(auth.uid).exists()"
        },
        "diag": {
          ".read": "auth != null && root.child('access').child($robot_id).child(auth.uid).val() === 'dev'"
        }
      }
    },
    "access": {
      "$robot_id": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": false
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['email'])"
      }
    }
  }
}
