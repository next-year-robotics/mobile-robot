{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "care-telemetry/1 robots/{robot_id}/sos/{sos_id}",
  "type": "object",
  "required": ["started_at_ms", "updated_at_ms", "reason", "severity", "trip_id", "app_received", "location"],
  "properties": {
    "started_at_ms": { "type": "integer", "minimum": 0 },
    "updated_at_ms": { "type": "integer", "minimum": 0 },
    "reason": { "type": "string", "enum": ["tracking_lost", "stuck", "low_battery", "manual", "unknown"] },
    "severity": { "type": "string", "enum": ["critical", "warning"] },
    "trip_id": { "type": ["string", "null"] },
    "app_received": { "type": "boolean" },
    "location": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["lat", "lon", "accuracy_m", "captured_at_ms", "source", "low_confidence"],
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lon": { "type": "number", "minimum": -180, "maximum": 180 },
            "accuracy_m": { "type": ["number", "null"], "minimum": 0 },
            "captured_at_ms": { "type": "integer", "minimum": 0 },
            "source": { "type": "string", "enum": ["cache", "fresh"] },
            "low_confidence": { "type": "boolean" }
          }
        }
      ]
    }
  }
}
