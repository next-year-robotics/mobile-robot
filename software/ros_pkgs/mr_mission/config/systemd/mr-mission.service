# mr_mission systemd 유닛(RPi5). follow를 켜서 로봇을 움직이는 노드다. 자동 기동(enable)은
# 사용자가 실주행 시험을 마친 뒤에만 한다. 그 전에는 `sudo systemctl start mr-mission`으로 지켜보며 띄운다.
[Unit]
Description=mr_mission (senior-care minimal mission: trip -> follow)
After=network-online.target

[Service]
Type=simple
User=emjdpi
Environment=ROS_DOMAIN_ID=0
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source /home/emjdpi/ros2_ws/install/setup.bash && exec ros2 run mr_mission mission --ros-args --params-file /home/emjdpi/ros2_ws/install/mr_mission/share/mr_mission/config/mission.yaml'
KillSignal=SIGINT
TimeoutStopSec=10
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
