<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mr_mission</name>
  <version>0.1.0</version>
  <description>시니어케어 최소 mission 노드. TripCommand로 follow 노드를 켜고 끄며 /robot/app_status를 발행한다. arrived는 OPEN-N1 전까지 내지 않는다.</description>
  <maintainer email="seongho06@khu.ac.kr">emjdp</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_srvs</depend>
  <depend>nav_msgs</depend>
  <depend>mr_care_msgs</depend>
  <depend>mr_msgs</depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>mr_phone_bridge</test_depend>  <!-- 앱→브리지→mission 통합 시험(없으면 skip) -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
