# 고정 마커 앞 정해진 자세로 정렬한다.
#
# 이 작은 현 로봇의 단일 마커 정렬에 필요한 최소 필드만 가진다.
# nav2_msgs/DockRobot과는 서로 다른 인터페이스이므로, opennav_docking으로 교체할 때는
# detected_dock_pose를 재사용하되 호출부 어댑터는 필요하다.

# ---- goal
uint16 marker_id

# 0.0이면 설정 파일의 기본값을 쓴다. 셋 다 마찬가지다.
float32 standoff_m 0.0
float32 goal_dist_tol_m 0.0
float32 goal_yaw_tol_rad 0.0
float32 stable_time_sec 0.0
float32 timeout_sec 0.0
---
# ---- result
uint16 NONE=0
uint16 MARKER_LOST=1
uint16 TIMEOUT=2
uint16 OSCILLATION=3
uint16 PREEMPTED=4
# 마커 법선이 거의 수직이라 yaw를 신뢰할 수 없다. 마커를 눕혀 단 경우다.
uint16 YAW_UNRELIABLE=5
uint16 UNKNOWN=99

bool success
uint16 error_code 0
string error_msg

# 종료 시점의 실제 오차. 성공/실패 모두 채운다.
float32 final_dist_m
float32 final_yaw_rad
---
# ---- feedback
uint8 PHASE_YAW=1
uint8 PHASE_DISTANCE=2
uint8 PHASE_FINAL=3

uint8 phase
float32 dist_err_m
float32 yaw_err_rad
float32 stable_for_sec
bool oscillating
builtin_interfaces/Duration elapsed
