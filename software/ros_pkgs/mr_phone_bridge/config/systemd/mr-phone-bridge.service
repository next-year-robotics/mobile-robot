# mr_phone_bridge systemd 유닛(RPi5). 베이스 스택과 별도로 돈다. 설치:
#   sudo cp mr-phone-bridge.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now mr-phone-bridge
#   journalctl -u mr-phone-bridge -f
# bash -c(비대화형)라 ~/.bashrc를 읽지 않는다. 옛 ROS_DOMAIN_ID=23이 끼어들지 않게 여기서 고정한다.
[Unit]
Description=mr_phone_bridge (phone-bridge/1 WebSocket gateway)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=emjdpi
Environment=ROS_DOMAIN_ID=0
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source /home/emjdpi/ros2_ws/install/setup.bash && exec ros2 run mr_phone_bridge phone_bridge --ros-args --params-file /home/emjdpi/ros2_ws/install/mr_phone_bridge/share/mr_phone_bridge/config/phone_bridge.yaml'
KillSignal=SIGINT
TimeoutStopSec=15
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
